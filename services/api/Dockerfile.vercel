FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    API_HOST=0.0.0.0 \
    PORT=80 \
    ENABLE_PLATFORM_DOWNLOADS=true \
    MAX_UPLOAD_BYTES=4194304 \
    MAX_IMAGE_UPLOAD_BYTES=3145728 \
    MAX_MEDIA_OUTPUT_BYTES=4194304

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY standalone.py ytdlp_worker.py verify_registry.py conversion_registry.json ./
RUN python verify_registry.py \
    && useradd --system --uid 10001 --create-home appuser \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 80
CMD ["python", "standalone.py"]
