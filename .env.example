# Local development only. Do not set this to localhost in Vercel environment variables.
# Production Vercel Services use same-origin /api routing from vercel.json.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API server settings
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_UPLOAD_BYTES=20971520
MAX_MEDIA_OUTPUT_BYTES=209715200
ENABLE_PLATFORM_DOWNLOADS=true
